{
  "description": "Relay mechanical checkpoints for Codex. No LLM. Resolves task via active-task registry. Requires /hooks trust.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/skills/handoff/bin/relay-run\" hook --host codex --event PreCompact",
            "statusMessage": "Relay mechanical checkpoint",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/skills/handoff/bin/relay-run\" hook --host codex --event SessionStart",
            "statusMessage": "Relay resume hint",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
