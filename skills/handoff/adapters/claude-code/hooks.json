{
  "description": "Relay mechanical checkpoints for Claude Code. No LLM. Resolves task via active-task registry (never assumes semantic task 'default').",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/skills/handoff}/bin/relay-run\" hook --host claude-code --event PreCompact",
            "statusMessage": "Relay mechanical checkpoint",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume|startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/handoff/bin/relay-run\" hook --host claude-code --event SessionStart",
            "statusMessage": "Relay resume hint",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
